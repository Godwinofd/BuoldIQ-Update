generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model ContactSubmission {
  id           String   @id @default(cuid())
  name         String
  email        String
  businessName String
  budget       String
  message      String
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())
}
